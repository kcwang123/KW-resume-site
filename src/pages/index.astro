---\nimport resume from '../data/resume.json';\nimport projects from '../data/projects.json';\nimport '../styles/global.css';\nimport '../styles/visual.css';\n\nconst base = import.meta.env.BASE_URL;\n---\n<html lang="en">\n<head>\n  <meta charset="utf-8" />\n  <meta name="viewport" content="width=device-width" />\n  <meta name="description" content={resume.profile.summary} />\n  <title>{resume.profile.name} — {resume.profile.title}</title>\n</head>\n<body class="visual-theme">\n  <header class="topbar shell">\n    <a class="brand" href={base}>KW</a>\n    <nav>\n      <a href="#experience">Experience</a>\n      <a href="#skills">Skills</a>\n      <a href={base + 'portfolio/'}>Portfolio</a>\n      <a href={base + 'console/'}>Console</a>\n    </nav>\n  </header>\n\n  <main class="shell">\n    <section class="resume-hero">\n      <div class="hero-copy">\n        <p class="eyebrow">SENIOR BACKEND / SYSTEMS ENGINEER</p>\n        <h1>{resume.profile.name}</h1>\n        <h2>{resume.profile.tagline}</h2>\n        <p class="lead">{resume.profile.summary}</p>\n        <div class="availability"><span></span>{resume.profile.location} · Remote</div>\n        <div class="actions">\n          <a class="primary" href="#experience">View experience</a>\n          <a href={base + 'portfolio/'}>Selected work</a>\n          <a href={resume.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>\n        </div>\n      </div>\n      <aside class="hero-note">\n        <p>Current focus</p>\n        <ul>{resume.focus.map((item) => <li>{item}</li>)}</ul>\n        <small>Public resume draft — deeper project stories are being expanded separately.</small>\n      </aside>\n    </section>\n\n    <section class="metrics-strip" aria-label="Career metrics">\n      {resume.metrics.map((m) => (\n        <article><strong>{m.value}</strong><span>{m.label}</span></article>\n      ))}\n    </section>\n\n    <section id="experience" class="resume-section">\n      <div class="section-kicker">01 / EXPERIENCE</div>\n      <div class="section-title">\n        <h2>Production systems, not demo apps.</h2>\n        <p>A concise public view of the work. Project pages go deeper into constraints, architecture, and trade-offs.</p>\n      </div>\n      <div class="experience-list">\n        {resume.experience.map((job, index) => (\n          <article class="experience-item">\n            <div class="experience-meta"><span>{job.period}</span><small>{job.location}</small></div>\n            <div class="experience-body">\n              <p class="role">{job.role}</p>\n              <h3>{job.company}</h3>\n              <p class="job-summary">{job.summary}</p>\n              <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>\n              <div class="tags">{job.stack.map((tag) => <span>{tag}</span>)}</div>\n            </div>\n            <div class="experience-index">0{index + 1}</div>\n          </article>\n        ))}\n      </div>\n    </section>\n\n    <section id="skills" class="resume-section">\n      <div class="section-kicker">02 / CORE SKILLS</div>\n      <div class="section-title compact"><h2>What I use to get systems shipped.</h2></div>\n      <div class="skills-grid">\n        {resume.skills.map((skill) => (\n          <article><h3>{skill.group}</h3><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></article>\n        ))}\n      </div>\n    </section>\n\n    <section class="resume-section">\n      <div class="section-kicker">03 / SELECTED WORK</div>\n      <div class="section-title"><h2>Three systems worth opening.</h2><a href={base + 'portfolio/'}>All case studies →</a></div>\n      <div class="selected-work">\n        {projects.map((p, index) => (\n          <article>\n            <div class="work-number">0{index + 1}</div>\n            <div>\n              <small>{p.status}</small>\n              <h3>{p.name}</h3>\n              <p class="work-subtitle">{p.subtitle}</p>\n              <p>{p.summary}</p>\n              <div class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</div>\n            </div>\n            <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>Open →</a>\n          </article>\n        ))}\n      </div>\n    </section>\n\n    <section class="closing">\n      <p class="eyebrow">REMOTE · TAIWAN</p>\n      <h2>Backend, integration, production ownership.</h2>\n      <p>This site is intentionally resume-first. The portfolio is where the systems get unpacked.</p>\n      <div class="actions"><a class="primary" href={base + 'portfolio/'}>View portfolio</a><a href={base + 'console/'}>Open developer console</a></div>\n    </section>\n  </main>\n\n  <footer class="shell"><span>Kevin Wang · {new Date().getFullYear()}</span><span>Built as a versioned resume, not a static PDF.</span></footer>\n</body>\n</html>