---
import resume from '../data/resume.json';
import projects from '../data/projects.json';
import '../styles/global.css';
import '../styles/console.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const featuredProjects = projects.filter((project) => project.featured);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={resume.profile.summary} />\n  <meta name="theme-color" content="#07100d" />\n  <link rel="canonical" href="https://kcwang.cyou/console/" />
  <title>{resume.profile.name} — Developer Console Resume</title>
</head>
<body class="console-theme">\n<a class="skip-link" href="#console-main">Skip to console</a>
<main id="console-main" class="terminal-shell">
  <header class="console-header">
    <div class="window-dots"><i></i><i></i><i></i></div>
    <nav><a href={base}>visual_resume</a><a href={base + 'portfolio/'}>portfolio</a></nav>
  </header>

  <section class="command-block intro">
    <p class="prompt">kevin@resume:~$ <span>whoami</span></p>
    <h1>{resume.profile.name}<b>_</b></h1>
    <p class="console-title">{resume.profile.title}</p>
    <p class="output">{resume.profile.summary}</p>
    <pre>{JSON.stringify({location: resume.profile.location, remote: true, focus: ['backend','integration','reliability']}, null, 2)}</pre>
  </section>

  <section class="command-block">
    <p class="prompt">kevin@resume:~$ <span>metrics --summary</span></p>
    <div class="console-metrics">{resume.metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div>
  </section>

  <section class="command-block">
    <p class="prompt">kevin@resume:~$ <span>experience --timeline</span></p>
    <div class="timeline">
      {resume.experience.map((job) => (
        <article>
          <div class="timeline-date">{job.period}</div>
          <div>
            <h2>{job.role}</h2>
            {job.officialTitle && <p class="official-title">official_title: {job.officialTitle}</p>}
            <h3>{job.company}</h3>
            <p>{job.summary}</p>
            <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>
            <div class="console-tags">{job.stack.map((tag) => <span>{tag}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="command-block">
    <p class="prompt">kevin@resume:~$ <span>skills --group all</span></p>
    <div class="skill-columns">
      {resume.skills.map((skill) => (
        <article>
          <h2>{skill.group.toLowerCase().replace(/\s+/g,'_')}</h2>
          {skill.items.map((item) => <p>+ {item}</p>)}
        </article>
      ))}
    </div>
  </section>

  <section class="command-block">
    <p class="prompt">kevin@resume:~$ <span>projects --featured</span></p>
    <div class="console-projects">
      {featuredProjects.map((p) => (
        <article>
          <div><small>[{p.category} · {p.status}]</small><h2>{p.name}</h2><p>{p.subtitle}</p><p class="muted">{p.summary}</p></div>
          <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>./open_case_study →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="command-block final-command">
    <p class="prompt">kevin@resume:~$ <span>next</span></p>
    <p class="output">Read the portfolio for architecture, constraints, operational details, and trade-offs.</p>
    <p><a href={base + 'portfolio/'}>open /portfolio →</a></p>
  </section>
</main>
</body>
</html>