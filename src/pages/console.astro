---\nimport resume from '../data/resume.json';\nimport projects from '../data/projects.json';\nimport '../styles/global.css';\nimport '../styles/console.css';\n\nconst base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';\n---\n<html lang="en">\n<head>\n  <meta charset="utf-8" />\n  <meta name="viewport" content="width=device-width" />\n  <meta name="description" content={resume.profile.summary} />\n  <title>{resume.profile.name} — Developer Console Resume</title>\n</head>\n<body class="console-theme">\n<main class="terminal-shell">\n  <header class="console-header">\n    <div class="window-dots"><i></i><i></i><i></i></div>\n    <nav><a href={base}>visual_resume</a><a href={base + 'portfolio/'}>portfolio</a></nav>\n  </header>\n\n  <section class="command-block intro">\n    <p class="prompt">kevin@resume:~$ <span>whoami</span></p>\n    <h1>{resume.profile.name}<b>_</b></h1>\n    <p class="console-title">{resume.profile.title}</p>\n    <p class="output">{resume.profile.summary}</p>\n    <pre>{JSON.stringify({location: resume.profile.location, remote: true, focus: ['backend','integration','reliability']}, null, 2)}</pre>\n  </section>\n\n  <section class="command-block">\n    <p class="prompt">kevin@resume:~$ <span>metrics --summary</span></p>\n    <div class="console-metrics">{resume.metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}</div>\n  </section>\n\n  <section class="command-block">\n    <p class="prompt">kevin@resume:~$ <span>experience --timeline</span></p>\n    <div class="timeline">\n      {resume.experience.map((job) => (\n        <article>\n          <div class="timeline-date">{job.period}</div>\n          <div>\n            <h2>{job.role}</h2>\n            <h3>{job.company}</h3>\n            <p>{job.summary}</p>\n            <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>\n            <div class="console-tags">{job.stack.map((tag) => <span>{tag}</span>)}</div>\n          </div>\n        </article>\n      ))}\n    </div>\n  </section>\n\n  <section class="command-block">\n    <p class="prompt">kevin@resume:~$ <span>skills --group all</span></p>\n    <div class="skill-columns">\n      {resume.skills.map((skill) => (\n        <article>\n          <h2>{skill.group.toLowerCase().replace(/\s+/g,'_')}</h2>\n          {skill.items.map((item) => <p>+ {item}</p>)}\n        </article>\n      ))}\n    </div>\n  </section>\n\n  <section class="command-block">\n    <p class="prompt">kevin@resume:~$ <span>projects --featured</span></p>\n    <div class="console-projects">\n      {projects.map((p) => (\n        <article>\n          <div><small>[{p.status}]</small><h2>{p.name}</h2><p>{p.subtitle}</p><p class="muted">{p.summary}</p></div>\n          <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>./open_case_study →</a>\n        </article>\n      ))}\n    </div>\n  </section>\n\n  <section class="command-block final-command">\n    <p class="prompt">kevin@resume:~$ <span>next</span></p>\n    <p class="output">Read the portfolio for architecture, constraints, operational details, and trade-offs.</p>\n    <p><a href={base + 'portfolio/'}>open /portfolio →</a></p>\n  </section>\n</main>\n</body>\n</html>