---\nimport projects from '../../data/projects.json';\nimport '../../styles/global.css';\nimport '../../styles/visual.css';\nconst base = import.meta.env.BASE_URL;\n---\n<html lang="en">\n<head>\n  <meta charset="utf-8" />\n  <meta name="viewport" content="width=device-width" />\n  <meta name="description" content="Selected backend systems and technical case studies by Kevin Wang." />\n  <title>Portfolio — Kevin Wang</title>\n</head>\n<body class="visual-theme">\n<header class="topbar shell"><a class="brand" href={base}>KW</a><nav><a href={base}>Resume</a><a href={base + 'console/'}>Console</a></nav></header>\n<main class="shell">\n  <section class="resume-hero portfolio-hero">\n    <div class="hero-copy">\n      <p class="eyebrow">PORTFOLIO / SYSTEMS</p>\n      <h1>Selected work.</h1>\n      <h2>The details that do not belong in a one-page resume.</h2>\n      <p class="lead">Architecture, delivery constraints, production behavior, trade-offs, and what I would modernize today.</p>\n    </div>\n  </section>\n  <section class="portfolio-list">\n    {projects.map((p, index) => (\n      <article>\n        <div class="work-number">0{index + 1}</div>\n        <div class="portfolio-copy">\n          <small>{p.status}</small>\n          <h2>{p.name}</h2>\n          <h3>{p.subtitle}</h3>\n          <p>{p.summary}</p>\n          <div class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</div>\n        </div>\n        <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>Read case study →</a>\n      </article>\n    ))}\n  </section>\n</main>\n</body>\n</html>