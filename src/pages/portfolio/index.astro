---
import projects from '../../data/projects.json';
import '../../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Portfolio — Kevin Wang</title></head>
<body>
<main class="shell">
  <header class="hero">
    <p class="eyebrow">PORTFOLIO</p>
    <h1>Selected systems and case studies</h1>
    <p class="lead">Deeper technical stories, architecture, constraints, trade-offs, and outcomes.</p>
    <nav class="actions"><a href={base}>← Resume</a><a href={`${base}console/`}>Developer Console</a></nav>
  </header>
  <section class="project-grid">
    {projects.map((p) => <article class="project-card"><div class="project-thumb"></div><h2>{p.name}</h2><p>{p.subtitle}</p><a href={`${base}${p.caseStudy.replace(/^\//, '')}/`}>Read case study →</a></article>)}
  </section>
</main>
</body>
</html>
