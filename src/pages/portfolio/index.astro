---
import projects from '../../data/projects.json';
import '../../styles/global.css';
import '../../styles/visual.css';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content="Selected backend systems and technical case studies by Kevin Wang." />
  <title>Portfolio — Kevin Wang</title>
</head>
<body class="visual-theme">
<header class="topbar shell"><a class="brand" href={base}>KW</a><nav><a href={base}>Resume</a><a href={base + 'console/'}>Console</a></nav></header>
<main class="shell">
  <section class="resume-hero portfolio-hero">
    <div class="hero-copy">
      <p class="eyebrow">PORTFOLIO / SYSTEMS</p>
      <h1>Selected work.</h1>
      <h2>The details that do not belong in a one-page resume.</h2>
      <p class="lead">Architecture, delivery constraints, production behavior, trade-offs, and what I would modernize today.</p>
    </div>
  </section>
  <section class="portfolio-list">
    {projects.map((p, index) => (
      <article>
        <div class="work-number">0{index + 1}</div>
        <div class="portfolio-copy">
          <small>{p.status}</small>
          <h2>{p.name}</h2>
          <h3>{p.subtitle}</h3>
          <p>{p.summary}</p>
          <div class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</div>
        </div>
        <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>Read case study →</a>
      </article>
    ))}
  </section>
</main>
</body>
</html>