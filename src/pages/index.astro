---
import resume from '../data/resume.json';
import projects from '../data/projects.json';
import '../styles/global.css';
import '../styles/visual.css';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={resume.profile.summary} />
  <title>{resume.profile.name} — {resume.profile.title}</title>
</head>
<body class="visual-theme">
  <header class="topbar shell">
    <a class="brand" href={base}>KW</a>
    <nav>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href={base + 'portfolio/'}>Portfolio</a>
      <a href={base + 'console/'}>Console</a>
    </nav>
  </header>

  <main class="shell">
    <section class="resume-hero">
      <div class="hero-copy">
        <p class="eyebrow">SENIOR BACKEND / SYSTEMS ENGINEER</p>
        <h1>{resume.profile.name}</h1>
        <h2>{resume.profile.tagline}</h2>
        <p class="lead">{resume.profile.summary}</p>
        <div class="availability"><span></span>{resume.profile.location} · Remote</div>
        <div class="actions">
          <a class="primary" href="#experience">View experience</a>
          <a href={base + 'portfolio/'}>Selected work</a>
          <a href={resume.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <aside class="hero-note">
        <p>Current focus</p>
        <ul>{resume.focus.map((item) => <li>{item}</li>)}</ul>
        <small>Public resume draft — deeper project stories are being expanded separately.</small>
      </aside>
    </section>

    <section class="metrics-strip" aria-label="Career metrics">
      {resume.metrics.map((m) => (
        <article><strong>{m.value}</strong><span>{m.label}</span></article>
      ))}
    </section>

    <section id="experience" class="resume-section">
      <div class="section-kicker">01 / EXPERIENCE</div>
      <div class="section-title">
        <h2>Production systems, not demo apps.</h2>
        <p>A concise public view of the work. Project pages go deeper into constraints, architecture, and trade-offs.</p>
      </div>
      <div class="experience-list">
        {resume.experience.map((job, index) => (
          <article class="experience-item">
            <div class="experience-meta"><span>{job.period}</span><small>{job.location}</small></div>
            <div class="experience-body">
              <p class="role">{job.role}</p>
              <h3>{job.company}</h3>
              <p class="job-summary">{job.summary}</p>
              <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>
              <div class="tags">{job.stack.map((tag) => <span>{tag}</span>)}</div>
            </div>
            <div class="experience-index">0{index + 1}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="resume-section">
      <div class="section-kicker">02 / CORE SKILLS</div>
      <div class="section-title compact"><h2>What I use to get systems shipped.</h2></div>
      <div class="skills-grid">
        {resume.skills.map((skill) => (
          <article><h3>{skill.group}</h3><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></article>
        ))}
      </div>
    </section>

    <section class="resume-section">
      <div class="section-kicker">03 / SELECTED WORK</div>
      <div class="section-title"><h2>Three systems worth opening.</h2><a href={base + 'portfolio/'}>All case studies →</a></div>
      <div class="selected-work">
        {projects.map((p, index) => (
          <article>
            <div class="work-number">0{index + 1}</div>
            <div>
              <small>{p.status}</small>
              <h3>{p.name}</h3>
              <p class="work-subtitle">{p.subtitle}</p>
              <p>{p.summary}</p>
              <div class="tags">{p.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
            <a href={base + p.caseStudy.replace(/^\//, '') + '/'}>Open →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="closing">
      <p class="eyebrow">REMOTE · TAIWAN</p>
      <h2>Backend, integration, production ownership.</h2>
      <p>This site is intentionally resume-first. The portfolio is where the systems get unpacked.</p>
      <div class="actions"><a class="primary" href={base + 'portfolio/'}>View portfolio</a><a href={base + 'console/'}>Open developer console</a></div>
    </section>
  </main>

  <footer class="shell"><span>Kevin Wang · {new Date().getFullYear()}</span><span>Built as a versioned resume, not a static PDF.</span></footer>
</body>
</html>